@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Good Morning, Brandon 👋</h2>

<p class="text-muted">
    Here's what's happening at your child's school today.
</p>

<div class="row">

    <!-- Emergency Alert -->

    <div class="col-12 mb-4">

        <div class="card border-danger shadow-sm">

            <div class="card-body">

                <h4 class="text-danger">
                    🚨 Emergency Alert
                </h4>

                <p class="mb-0">
                    School closes today at 12:00 due to severe weather.
                </p>

            </div>

        </div>

    </div>

</div>

<div class="row">

    <!-- Announcements -->

    <div class="col-lg-8">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                Latest Announcements

            </div>

            <div class="card-body">

                <ul class="list-group list-group-flush">

                    <li class="list-group-item">
                        Parent Meeting - Thursday
                    </li>

                    <li class="list-group-item">
                        Grade 8 Camp Forms Available
                    </li>

                    <li class="list-group-item">
                        Rugby Practice Cancelled
                    </li>

                </ul>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="col-lg-4">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">

                Quick Actions

            </div>

            <div class="card-body d-grid gap-2">

                <a class="btn btn-primary">
                    Messages
                </a>

                <a class="btn btn-primary">
                    Calendar
                </a>

                <a class="btn btn-primary">
                    Learner Progress
                </a>

                <a class="btn btn-primary">
                    Payments
                </a>

                <a class="btn btn-primary">
                    School Store
                </a>

                <a class="btn btn-primary">
                    AI Assistant
                </a>

            </div>

        </div>

    </div>

</div>