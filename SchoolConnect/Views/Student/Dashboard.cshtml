@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Student Dashboard";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            Welcome back!
        </h2>

        <p class="text-muted">
            View your classes, homework and important school announcements.
        </p>

    </div>


    <div class="row">

        <div class="col-lg-4">

            <div class="dashboard-card">

                <h3>6</h3>

                <p>My Classes</p>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="dashboard-card">

                <h3>3</h3>

                <p>Homework Due</p>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="dashboard-card">

                <h3>2</h3>

                <p>New Announcements</p>

            </div>

        </div>

    </div>


    <div class="row mt-4">


        <!-- Upcoming Homework -->

        <div class="col-lg-7">

            <div class="card custom-card">

                <div class="card-header">

                    <strong>
                        Upcoming Homework
                    </strong>

                </div>


                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">

                        <div>

                            <strong>Mathematics</strong>

                            <p class="text-muted mb-0">
                                Algebra Worksheet
                            </p>

                        </div>

                        <span class="badge bg-danger">
                            Due 18 Aug
                        </span>

                    </div>


                    <hr>


                    <div class="d-flex justify-content-between mb-3">

                        <div>

                            <strong>Science</strong>

                            <p class="text-muted mb-0">
                                Chapter 5 Questions
                            </p>

                        </div>

                        <span class="badge bg-warning text-dark">
                            Due 20 Aug
                        </span>

                    </div>


                    <hr>


                    <div class="d-flex justify-content-between">

                        <div>

                            <strong>English</strong>

                            <p class="text-muted mb-0">
                                Reading Assignment
                            </p>

                        </div>

                        <span class="badge bg-success">
                            Due 23 Aug
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Announcements -->

        <div class="col-lg-5">

            <div class="card custom-card">

                <div class="card-header">

                    <strong>
                        Latest Announcements
                    </strong>

                </div>


                <div class="card-body">

                    <p>
                        <strong>Sports Day</strong>
                    </p>

                    <small class="text-muted">
                        Sports Day will take place on 25 August.
                    </small>

                    <hr>

                    <p>
                        <strong>School Assembly</strong>
                    </p>

                    <small class="text-muted">
                        All Grade 8 learners must attend Friday's assembly.
                    </small>

                </div>

            </div>

        </div>

    </div>

</div>