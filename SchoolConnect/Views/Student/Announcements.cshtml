@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Announcements";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            Announcements
        </h2>

        <p class="text-muted">
            View important announcements from your school and teachers.
        </p>

    </div>


    <div class="card custom-card">

        <div class="card-body">


            <div class="mb-4">

                <h5 class="text-primary">
                    Mathematics Test
                </h5>

                <small class="text-muted">
                    Mathematics • 17 August 2026
                </small>

                <p class="mt-2">
                    Remember to revise Chapters 3 and 4 for the upcoming Mathematics test.
                </p>

            </div>


            <hr>


            <div class="mb-4">

                <h5 class="text-success">
                    Sports Day
                </h5>

                <small class="text-muted">
                    School Announcement • 15 August 2026
                </small>

                <p class="mt-2">
                    Sports Day will take place on 25 August. Learners should arrive at school by 08:00.
                </p>

            </div>


            <hr>


            <div>

                <h5 class="text-warning">
                    Parent Meeting
                </h5>

                <small class="text-muted">
                    School Announcement • 12 August 2026
                </small>

                <p class="mt-2">
                    Parents are invited to attend the upcoming learner progress meeting.
                </p>

            </div>

        </div>

    </div>

</div>