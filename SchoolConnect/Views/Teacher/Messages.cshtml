@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Messages";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">Messages</h2>

        <p class="text-muted">
            Communicate with parents, teachers and school administration.
        </p>

    </div>

    <div class="row">

        <!-- Conversations -->

        <div class="col-lg-4">

            <div class="card custom-card">

                <div class="card-header">

                    Conversations

                </div>

                <div class="list-group list-group-flush">

                    <a href="#" class="list-group-item list-group-item-action active">

                        <strong>Sarah Johnson</strong><br>

                        <small>Emma's parent</small>

                    </a>

                    <a href="#" class="list-group-item list-group-item-action">

                        <strong>Mr Daniels</strong><br>

                        <small>Principal</small>

                    </a>

                    <a href="#" class="list-group-item list-group-item-action">

                        <strong>Mrs Naidoo</strong><br>

                        <small>Grade 9 Parent</small>

                    </a>

                    <a href="#" class="list-group-item list-group-item-action">

                        <strong>Ms Smith</strong><br>

                        <small>Science Teacher</small>

                    </a>

                </div>

            </div>

        </div>

        <!-- Chat Window -->

        <div class="col-lg-8">

            <div class="card custom-card">

                <div class="card-header">

                    Sarah Johnson (Parent)

                </div>

                <div class="card-body" style="height:420px; overflow-y:auto;">

                    <div class="mb-3">

                        <div class="alert alert-light">

                            Good afternoon. Emma was absent today due to a doctor's appointment.

                        </div>

                    </div>

                    <div class="mb-3 text-end">

                        <div class="alert alert-primary d-inline-block">

                            Thank you for letting me know. I hope she feels better soon.

                        </div>

                    </div>

                    <div class="mb-3">

                        <div class="alert alert-light">

                            Could you please upload today's Maths notes?

                        </div>

                    </div>

                    <div class="mb-3 text-end">

                        <div class="alert alert-primary d-inline-block">

                            Certainly. I'll upload them this afternoon.

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="input-group">

                        <input type="text"
                               class="form-control"
                               placeholder="Type your message...">

                        <button class="btn btn-primary">

                            <i class="bi bi-send-fill"></i>

                            Send

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>