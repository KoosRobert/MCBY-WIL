@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Announcements";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">Class Announcements</h2>

            <p class="text-muted mb-0">
                Create and send announcements to your classes and parents.
            </p>

        </div>

        <button class="btn btn-primary">

            <i class="bi bi-megaphone-fill"></i>

            New Announcement

        </button>

    </div>

    <div class="row">

        <!-- Create Announcement -->

        <div class="col-lg-4">

            <div class="card custom-card">

                <div class="card-header">

                    Create Announcement

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <label class="form-label">Class</label>

                        <select class="form-select">

                            <option>Grade 8A</option>
                            <option>Grade 9B</option>
                            <option>Grade 10A</option>
                            <option>Grade 11B</option>
                            <option>Grade 12A</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Subject</label>

                        <input type="text"
                               class="form-control"
                               placeholder="Announcement title">

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Message</label>

                        <textarea class="form-control"
                                  rows="7"
                                  placeholder="Type your announcement..."></textarea>

                    </div>

                    <button class="btn btn-success w-100">

                        <i class="bi bi-send-fill"></i>

                        Send Announcement

                    </button>

                </div>

            </div>

        </div>

        <!-- Previous Announcements -->

        <div class="col-lg-8">

            <div class="card custom-card">

                <div class="card-header">

                    Recent Announcements

                </div>

                <div class="card-body">

                    <div class="announcement-item">

                        <h5 class="text-primary">
                            Mathematics Test Reminder
                        </h5>

                        <small class="text-muted">
                            Grade 8A • Yesterday
                        </small>

                        <p class="mt-2">
                            Please remember to revise Chapters 3 and 4 for Friday's Mathematics test.
                        </p>

                    </div>

                    <hr>

                    <div class="announcement-item">

                        <h5 class="text-success">
                            Homework Submission
                        </h5>

                        <small class="text-muted">
                            Grade 9B • Monday
                        </small>

                        <p class="mt-2">
                            Homework must be submitted before 08:00 tomorrow morning.
                        </p>

                    </div>

                    <hr>

                    <div class="announcement-item">

                        <h5 class="text-danger">
                            Parent Meeting
                        </h5>

                        <small class="text-muted">
                            Grade 10A • Last Week
                        </small>

                        <p class="mt-2">
                            Parents are invited to attend a learner progress meeting next Wednesday at 17:30.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>