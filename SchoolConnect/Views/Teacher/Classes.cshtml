@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "My Classes";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">My Classes</h2>

            <p class="text-muted mb-0">
                View your assigned classes and access learner information.
            </p>

        </div>

        <button class="btn btn-primary">

            <i class="bi bi-search"></i>

            Search Learner

        </button>

    </div>

    <div class="row g-4">

        <!-- Grade 8A -->

        <div class="col-lg-4">

            <div class="card custom-card h-100">

                <div class="card-body text-center">

                    <i class="bi bi-journal-bookmark-fill display-4 text-primary"></i>

                    <h4 class="mt-3">Grade 8A</h4>

                    <p class="text-muted">
                        Mathematics
                    </p>

                    <hr>

                    <p><strong>35</strong> Learners</p>

                    <p>Room B12</p>

                    <p>08:00 - 09:00</p>

                    <a asp-controller="Teacher"
                       asp-action="Marks"
                       class="btn btn-primary w-100">

                        Open Class

                    </a>

                </div>

            </div>

        </div>

        <!-- Grade 9B -->

        <div class="col-lg-4">

            <div class="card custom-card h-100">

                <div class="card-body text-center">

                    <i class="bi bi-journal-bookmark-fill display-4 text-success"></i>

                    <h4 class="mt-3">Grade 9B</h4>

                    <p class="text-muted">
                        Mathematics
                    </p>

                    <hr>

                    <p><strong>32</strong> Learners</p>

                    <p>Room B12</p>

                    <p>09:15 - 10:15</p>

                    <a asp-controller="Teacher"
                       asp-action="Marks"
                       class="btn btn-success w-100">

                        Open Class

                    </a>

                </div>

            </div>

        </div>

        <!-- Grade 10A -->

        <div class="col-lg-4">

            <div class="card custom-card h-100">

                <div class="card-body text-center">

                    <i class="bi bi-journal-bookmark-fill display-4 text-warning"></i>

                    <h4 class="mt-3">Grade 10A</h4>

                    <p class="text-muted">
                        Mathematics
                    </p>

                    <hr>

                    <p><strong>29</strong> Learners</p>

                    <p>Room B14</p>

                    <p>11:00 - 12:00</p>

                    <a asp-controller="Teacher"
                       asp-action="Marks"
                       class="btn btn-warning text-white w-100">

                        Open Class

                    </a>

                </div>

            </div>

        </div>

        <!-- Grade 11B -->

        <div class="col-lg-4">

            <div class="card custom-card h-100">

                <div class="card-body text-center">

                    <i class="bi bi-journal-bookmark-fill display-4 text-danger"></i>

                    <h4 class="mt-3">Grade 11B</h4>

                    <p class="text-muted">
                        Mathematics
                    </p>

                    <hr>

                    <p><strong>31</strong> Learners</p>

                    <p>Room C02</p>

                    <p>13:00 - 14:00</p>

                    <a asp-controller="Teacher"
                       asp-action="Marks"
                       class="btn btn-danger w-100">

                        Open Class

                    </a>

                </div>

            </div>

        </div>

        <!-- Grade 12A -->

        <div class="col-lg-4">

            <div class="card custom-card h-100">

                <div class="card-body text-center">

                    <i class="bi bi-journal-bookmark-fill display-4 text-info"></i>

                    <h4 class="mt-3">Grade 12A</h4>

                    <p class="text-muted">
                        Mathematics
                    </p>

                    <hr>

                    <p><strong>27</strong> Learners</p>

                    <p>Room C04</p>

                    <p>14:15 - 15:15</p>

                    <a asp-controller="Teacher"
                       asp-action="Marks"
                       class="btn btn-info text-white w-100">

                        Open Class

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>