@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "AI Assistant";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">Teacher AI Assistant</h2>

        <p class="text-muted">
            Your AI teaching assistant to help with lesson planning, communication and assessments.
        </p>

    </div>

    <div class="row">

        <!-- AI Chat -->

        <div class="col-lg-8">

            <div class="card custom-card">

                <div class="card-header">

                    AI Chat

                </div>

                <div class="card-body" style="height:450px; overflow-y:auto;">

                    <div class="alert alert-secondary">

                        👋 Hello! I'm your SchoolConnect+ AI Assistant.

                        How can I help you today?

                    </div>

                    <div class="alert alert-light">

                        Generate a Grade 8 Mathematics quiz on Algebra.

                    </div>

                    <div class="alert alert-primary">

                        Certainly! Here's a 10-question Algebra quiz suitable for Grade 8 learners, complete with an answer memo.

                    </div>

                </div>

                <div class="card-footer">

                    <div class="input-group">

                        <input type="text"
                               class="form-control"
                               placeholder="Ask the AI anything...">

                        <button class="btn btn-primary">

                            <i class="bi bi-send-fill"></i>

                            Send

                        </button>

                    </div>

                </div>

            </div>

        </div>

        <!-- AI Features -->

        <div class="col-lg-4">

            <div class="card custom-card">

                <div class="card-header">

                    AI Shortcuts

                </div>

                <div class="card-body d-grid gap-3">

                    <button class="btn btn-outline-primary">

                        📝 Generate Lesson Plan

                    </button>

                    <button class="btn btn-outline-success">

                        📚 Create Quiz

                    </button>

                    <button class="btn btn-outline-warning">

                        ✉️ Draft Parent Message

                    </button>

                    <button class="btn btn-outline-info">

                        📢 Write Announcement

                    </button>

                    <button class="btn btn-outline-danger">

                        📊 Analyse Class Performance

                    </button>

                    <button class="btn btn-dark">

                        💡 Teaching Ideas

                    </button>

                </div>

            </div>

            <div class="card custom-card mt-4">

                <div class="card-header">

                    Popular AI Requests

                </div>

                <div class="card-body">

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">
                            Create worksheets
                        </li>

                        <li class="list-group-item">
                            Explain difficult concepts
                        </li>

                        <li class="list-group-item">
                            Generate homework
                        </li>

                        <li class="list-group-item">
                            Summarise learner performance
                        </li>

                        <li class="list-group-item">
                            Write professional emails
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>