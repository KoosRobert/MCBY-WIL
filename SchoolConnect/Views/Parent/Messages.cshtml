@{
    Layout = "_ParentLayout";
    ViewData["Title"] = "Messages";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">Messages</h2>
        <p class="text-muted">
            Stay connected with teachers and the school.
        </p>
    </div>

    <div class="row">

        <!-- Conversation List -->

        <div class="col-lg-4">

            <div class="card custom-card">

                <div class="card-header">

                    Conversations

                </div>

                <div class="list-group list-group-flush">

                    <a href="#" class="list-group-item list-group-item-action active">

                        <strong>Mrs Smith</strong><br />

                        <small>Grade 8 Mathematics</small>

                    </a>

                    <a href="#" class="list-group-item list-group-item-action">

                        <strong>School Administration</strong><br />

                        <small>School Fees Reminder</small>

                    </a>

                    <a href="#" class="list-group-item list-group-item-action">

                        <strong>Sports Department</strong><br />

                        <small>Practice Cancelled</small>

                    </a>

                    <a href="#" class="list-group-item list-group-item-action">

                        <strong>Principal</strong><br />

                        <small>Monthly Newsletter</small>

                    </a>

                </div>

            </div>

        </div>

        <!-- Chat Window -->

        <div class="col-lg-8">

            <div class="card custom-card">

                <div class="card-header">

                    Mrs Smith - Grade 8 Mathematics

                </div>

                <div class="card-body chat-body">

                    <div class="message received">

                        Good afternoon Brandon.

                        Liam has been doing very well in Mathematics this term.

                    </div>

                    <div class="message sent">

                        Thank you! We'll keep encouraging him.

                    </div>

                    <div class="message received">

                        Please remember that the test will be written on Friday.

                    </div>

                </div>

                <div class="card-footer">

                    <div class="input-group">

                        <input type="text"
                               class="form-control"
                               placeholder="Type your message..." />

                        <button class="btn btn-primary">

                            <i class="bi bi-send-fill"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>