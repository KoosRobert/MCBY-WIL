@{
    Layout = "_ParentLayout";
    ViewData["Title"] = "School Store";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">School Store 🛍️</h2>
        <p class="text-muted">
            Purchase uniforms, stationery, textbooks and event tickets online.
        </p>
    </div>

    <!-- Search & Category -->

    <div class="row mb-4">

        <div class="col-md-8">

            <input type="text"
                   class="form-control"
                   placeholder="Search products..." />

        </div>

        <div class="col-md-4">

            <select class="form-select">

                <option>All Categories</option>
                <option>Uniforms</option>
                <option>Books</option>
                <option>Stationery</option>
                <option>Sports</option>

            </select>

        </div>

    </div>

    <div class="row g-4">

        <!-- Product 1 -->

        <div class="col-lg-3 col-md-6">

            <div class="card custom-card h-100">

                <img src="https://placehold.co/300x220?text=School+Blazer"
                     class="card-img-top">

                <div class="card-body">

                    <h5>School Blazer</h5>

                    <p class="text-muted">
                        Official school blazer.
                    </p>

                    <h4 class="text-primary">
                        R850
                    </h4>

                </div>

                <div class="card-footer bg-white border-0">

                    <button class="btn btn-primary w-100">
                        Add to Cart
                    </button>

                </div>

            </div>

        </div>

        <!-- Product 2 -->

        <div class="col-lg-3 col-md-6">

            <div class="card custom-card h-100">

                <img src="https://placehold.co/300x220?text=Maths+Textbook"
                     class="card-img-top">

                <div class="card-body">

                    <h5>Mathematics Textbook</h5>

                    <p class="text-muted">
                        Grade 8 CAPS Edition.
                    </p>

                    <h4 class="text-primary">
                        R420
                    </h4>

                </div>

                <div class="card-footer bg-white border-0">

                    <button class="btn btn-primary w-100">
                        Add to Cart
                    </button>

                </div>

            </div>

        </div>

        <!-- Product 3 -->

        <div class="col-lg-3 col-md-6">

            <div class="card custom-card h-100">

                <img src="https://placehold.co/300x220?text=Stationery+Pack"
                     class="card-img-top">

                <div class="card-body">

                    <h5>Stationery Pack</h5>

                    <p class="text-muted">
                        Complete Grade 8 stationery kit.
                    </p>

                    <h4 class="text-primary">
                        R250
                    </h4>

                </div>

                <div class="card-footer bg-white border-0">

                    <button class="btn btn-primary w-100">
                        Add to Cart
                    </button>

                </div>

            </div>

        </div>

        <!-- Product 4 -->

        <div class="col-lg-3 col-md-6">

            <div class="card custom-card h-100">

                <img src="https://placehold.co/300x220?text=Sports+Shirt"
                     class="card-img-top">

                <div class="card-body">

                    <h5>Sports Shirt</h5>

                    <p class="text-muted">
                        Official PE uniform.
                    </p>

                    <h4 class="text-primary">
                        R350
                    </h4>

                </div>

                <div class="card-footer bg-white border-0">

                    <button class="btn btn-primary w-100">
                        Add to Cart
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>