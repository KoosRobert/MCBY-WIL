@{
    Layout = "_ParentLayout";
    ViewData["Title"] = "School Calendar";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">School Calendar</h2>
        <p class="text-muted">
            View important school events, meetings and examination dates.
        </p>
    </div>

    <div class="row">

        <!-- Calendar -->

        <div class="col-lg-8">

            <div class="card custom-card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">August 2026</h5>

                    <div>
                        <button class="btn btn-sm btn-outline-primary">&lt;</button>
                        <button class="btn btn-sm btn-outline-primary">&gt;</button>
                    </div>

                </div>

                <div class="card-body p-2">

                    <table class="table table-bordered calendar-table text-center align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Sun</th>
                                <th>Mon</th>
                                <th>Tue</th>
                                <th>Wed</th>
                                <th>Thu</th>
                                <th>Fri</th>
                                <th>Sat</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="calendar-day">1</td>
                                <td class="calendar-day">2</td>
                            </tr>

                            <tr>
                                <td class="calendar-day">3</td>
                                <td class="calendar-day">4</td>
                                <td class="calendar-day">5</td>
                                <td class="calendar-day">6</td>
                                <td class="calendar-day event-blue">
                                    7
                                    <small>Meeting</small>
                                </td>
                                <td class="calendar-day">8</td>
                                <td class="calendar-day">9</td>
                            </tr>

                            <tr>
                                <td class="calendar-day">10</td>
                                <td class="calendar-day">11</td>
                                <td class="calendar-day event-green">
                                    12
                                    <small>Sports</small>
                                </td>
                                <td class="calendar-day">13</td>
                                <td class="calendar-day">14</td>
                                <td class="calendar-day event-red">
                                    15
                                    <small>Exam</small>
                                </td>
                                <td class="calendar-day">16</td>
                            </tr>

                            <tr>
                                <td class="calendar-day">17</td>
                                <td class="calendar-day">18</td>
                                <td class="calendar-day">19</td>
                                <td class="calendar-day">20</td>
                                <td class="calendar-day">21</td>
                                <td class="calendar-day">22</td>
                                <td class="calendar-day">23</td>
                            </tr>

                            <tr>
                                <td class="calendar-day">24</td>
                                <td class="calendar-day">25</td>
                                <td class="calendar-day">26</td>
                                <td class="calendar-day">27</td>
                                <td class="calendar-day">28</td>
                                <td class="calendar-day">29</td>
                                <td class="calendar-day">30</td>
                            </tr>

                            <tr>
                                <td class="calendar-day">31</td>
                                <td colspan="6"></td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Upcoming Events -->

        <div class="col-lg-4">

            <div class="card custom-card">

                <div class="card-header">

                    Upcoming Events

                </div>

                <div class="card-body">

                    <div class="event-item">

                        <h6 class="text-primary">
                            Parent Meeting
                        </h6>

                        <small>7 August • 18:00</small>

                    </div>

                    <hr>

                    <div class="event-item">

                        <h6 class="text-success">
                            Sports Day
                        </h6>

                        <small>12 August</small>

                    </div>

                    <hr>

                    <div class="event-item">

                        <h6 class="text-danger">
                            Mathematics Test
                        </h6>

                        <small>15 August</small>

                    </div>

                    <hr>

                    <div class="event-item">

                        <h6 class="text-warning">
                            Grade 8 Camp
                        </h6>

                        <small>25 August</small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>