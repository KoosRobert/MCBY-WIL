@{
    Layout = "_ParentLayout";
    ViewData["Title"] = "Learner Progress";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">Learner Progress</h2>
        <p class="text-muted">
            Monitor your child's academic performance, attendance and teacher feedback.
        </p>
    </div>

    <div class="row">

        <!-- Student Profile -->

        <div class="col-lg-4">

            <div class="card custom-card mb-4">

                <div class="card-body text-center">

                    <div class="student-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                         class="rounded-circle mb-3"
                         alt="Student" />

                    <h4>Liam Smith</h4>

                    <p class="text-muted">
                        Grade 8A
                    </p>

                    <hr>

                    <p><strong>Student No:</strong> SC20260045</p>
                    <p><strong>Class Teacher:</strong> Mrs Smith</p>

                </div>

            </div>

            <!-- Attendance -->

            <div class="card custom-card">

                <div class="card-header">

                    Attendance

                </div>

                <div class="card-body text-center">

                    <h1 class="text-success">
                        96%
                    </h1>

                    <p>This Term</p>

                    <div class="progress">

                        <div class="progress-bar bg-success"
                             style="width:96%">
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Academic Results -->

        <div class="col-lg-8">

            <div class="card custom-card mb-4">

                <div class="card-header">

                    Subject Performance

                </div>

                <div class="card-body">

                    <table class="table table-hover">

                        <thead>

                            <tr>

                                <th>Subject</th>

                                <th>Average</th>

                                <th>Teacher</th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>Mathematics</td>

                                <td>82%</td>

                                <td>Mrs Smith</td>

                            </tr>

                            <tr>

                                <td>English</td>

                                <td>78%</td>

                                <td>Mr Jacobs</td>

                            </tr>

                            <tr>

                                <td>Natural Science</td>

                                <td>91%</td>

                                <td>Mrs Daniels</td>

                            </tr>

                            <tr>

                                <td>History</td>

                                <td>80%</td>

                                <td>Mrs Brown</td>

                            </tr>

                            <tr>

                                <td>Life Orientation</td>

                                <td>88%</td>

                                <td>Mr Naidoo</td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- Teacher Comments -->

            <div class="card custom-card">

                <div class="card-header">

                    Teacher Feedback

                </div>

                <div class="card-body">

                    <div class="alert alert-success">

                        <strong>Mathematics</strong><br />

                        Liam has shown excellent improvement this term and actively participates in class discussions.

                    </div>

                    <div class="alert alert-info">

                        <strong>English</strong><br />

                        Reading comprehension has improved significantly. Continue practising essay writing.

                    </div>

                    <div class="alert alert-warning">

                        <strong>General Feedback</strong><br />

                        Please ensure homework is submitted before Friday each week.

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>